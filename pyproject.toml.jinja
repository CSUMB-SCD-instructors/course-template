[project]
name = {{ project_name | tojson }}
version = "0.1.0"
description = {{ ("Course materials and tools for " ~ course_name) | tojson }}
readme = "README.md"
requires-python = ">=3.11"
dependencies = []

[project.optional-dependencies]
# Install with `uv sync --extra course-management` or
# `python -m pip install ".[course-management]"`.
course-management = [
  "colorama>=0.4.6",
  "pyyaml>=6.0.2",
  "jinja2>=3.1.6",
  "gitpython>=3.1.51",
  "pygithub>=2.9.1",
]

[dependency-groups]
dev = [
  "pytest>=9.1.1",
]

[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

# This is a course repository, not a distributable Python package. This makes
# pip install dependency extras without attempting package discovery.
[tool.setuptools]
packages = []
