#!/usr/bin/env bash
# Merge the latest instructor release into the currently checked-out student branch.
set -euo pipefail

BASE_REMOTE="course-base"
BASE_URL="{{ base_repo_url }}"
BASE_BRANCH="{{ student_repositories.base_branch }}"

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Your working tree has uncommitted changes. Commit or stash them before updating."
  exit 1
fi

if git remote get-url "$BASE_REMOTE" >/dev/null 2>&1; then
  git remote set-url "$BASE_REMOTE" "$BASE_URL"
else
  git remote add "$BASE_REMOTE" "$BASE_URL"
fi

git fetch "$BASE_REMOTE" "$BASE_BRANCH"
git merge --no-edit "$BASE_REMOTE/$BASE_BRANCH"
