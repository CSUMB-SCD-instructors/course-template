#!/usr/bin/env bash
# Merge the latest instructor release into the currently checked-out student branch.
set -euo pipefail

BASE_BRANCH="base"

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Your working tree has uncommitted changes. Commit or stash them before updating."
  exit 1
fi

# Every private student repository receives a publisher-managed base branch.
# Fetching from origin lets students update without configuring a separate
# course-base remote.
git fetch origin "$BASE_BRANCH"
git merge --no-edit "origin/$BASE_BRANCH"
